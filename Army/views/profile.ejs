<!DOCTYPE html>
<html>
<head>
    <title>Officer Profile</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>

<div class="profile-card">
    <h1>🇮🇳 Indian Army</h1>

    <h2><%= user.rank %></h2>
    <h3><%= user.name %></h3>

    <p><strong>Unit:</strong> <%= user.unit %></p>
    <p><%= user.badge %></p>

    <a href="/logout">
        <button>Logout</button>
    </a>
</div>

</body>
</html>